{
    "pytorch_version": "2.14.0+cpu",
    "cuda_available": false,
    "device": "cpu",
    "batch_size": 16,
    "image_resolution": [
        256,
        256
    ],
    "optimizer": "AdamW",
    "initial_learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "loss_function": "0.5 * BCEWithLogitsLoss + 0.5 * DiceLoss",
    "augmentation": {
        "horizontal_flip_prob": 0.5,
        "vertical_flip_prob": 0.5,
        "rotation_degrees": [
            -10,
            10
        ]
    },
    "max_epochs": 25,
    "early_stopping_patience": 10,
    "seed": 42,
    "train_samples": 3146,
    "val_samples": 787,
    "test_samples": 860
}